[Unit]
Description=Proseden (__NAME__)
After=network.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__PREFIX__/__NAME__/current
EnvironmentFile=__PREFIX__/__NAME__/env
ExecStart=__NODE__ dist/server.js
Restart=on-failure
RestartSec=3
# File-backed world; give writes a moment to finish on stop
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
